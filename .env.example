# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.
# On Vercel, set these in Project Settings → Environment Variables instead.
# See ADMIN_SETUP.md for how to obtain each value.

# --- Auth.js (admin sign-in) ---
# Random 32-byte secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth 2.0 client credentials (Google Cloud → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: restrict the Google account picker to a hosted domain (a hint, not the gate)
AUTH_GOOGLE_HD=ozyegin.edu.tr
# The single email allowed into /admin (exact match gates access)
ADMIN_EMAIL=

# --- Vercel Blob (editable content store) ---
# Auto-provisioned by Vercel when you create/connect a Blob store
BLOB_READ_WRITE_TOKEN=
# Public base URL of the Blob store, e.g. https://abc123.public.blob.vercel-storage.com
# Printed by `npm run seed:blob`
BLOB_PUBLIC_BASE_URL=

# --- Spotify (optional; powers the admin Spotify integration) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: pin a refresh token instead of using the in-app connect flow
SPOTIFY_REFRESH_TOKEN=
